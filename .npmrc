# 本机直连 registry.npmjs.org 速度只有 20~40 KiB/s，安装大包会超时。
# npmmirror（阿里云）实测快约 100 倍，故固定使用国内镜像。
registry=https://registry.npmmirror.com

# 大包（echarts / typescript / esbuild 二进制）需要更宽的容忍度
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# 降低并发，避免弱网下多个大包互相抢带宽
network-concurrency=6
